# =============================================================
# Backend Environment Variables (Render / Cloud / Local)
# =============================================================

# Server Port (Render sets this dynamically via PORT)
PORT=8081

# PostgreSQL Database (Render Managed PostgreSQL provides DATABASE_URL automatically)
# Example: postgres://doctor_user:password@dpg-xxxx.render.com/doctor_appointment
DATABASE_URL=postgres://postgres:postgres@localhost:5432/doctor_appointment

# Alternatively, configure individual JDBC properties:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/doctor_appointment
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# Frontend Allowed Origin for CORS (comma-separated if multiple)
FRONTEND_ORIGIN=https://doctor-frontend-blue.vercel.app,http://localhost:5173

# Cross-Site Cookie Configuration (required when frontend is on Vercel and backend is on Render)
SESSION_COOKIE_SAMESITE=none
SESSION_COOKIE_SECURE=true

# Admin Account Seed (automatically created on first boot)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=AdminPassword123!
